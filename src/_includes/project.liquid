<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }} | Aazam Khan</title>
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-page: #EFEFEF; --text-main: #0E0E0E; --text-muted: #555555;
            --sec-1: #01BAEF; --sec-2: #00799C;
            --glass-bg: rgba(235, 235, 235, 0.62); --glass-border: 1px solid rgba(255, 255, 255, 0.75);
            --glass-shadow: 0 16px 36px rgba(0, 0, 0, 0.08); --btn-radius: 10px;
        }
        body {
            font-family: 'Inter', sans-serif; background: linear-gradient(135deg, #EFEFEF 0%, #E2E2E2 100%);
            color: var(--text-main); margin: 0; padding: 0; line-height: 1.6;
        }
        nav {
            padding: 20px 40px; background: var(--glass-bg); backdrop-filter: blur(24px);
            border-bottom: var(--glass-border); position: sticky; top: 0; z-index: 100;
        }
        .back-btn {
            text-decoration: none; font-family: 'Barlow Condensed', sans-serif; font-size: 20px;
            font-weight: 700; color: var(--text-main); text-transform: uppercase;
        }
        .back-btn:hover { color: var(--sec-1); }
        
        .container { max-width: 900px; margin: 60px auto; padding: 0 20px; }
        .glass-panel {
            background: var(--glass-bg); backdrop-filter: blur(24px); border: var(--glass-border);
            box-shadow: var(--glass-shadow); padding: 50px; border-radius: var(--btn-radius);
        }
        h1 { font-family: 'Barlow Condensed', sans-serif; font-size: 56px; text-transform: uppercase; margin: 0 0 30px 0; line-height: 1.1; }
        
        .subtitle-text { font-size: 16px; color: var(--text-muted); margin-bottom: 40px; white-space: pre-wrap; line-height: 1.8; }
        .project-media { margin-bottom: 40px; display: flex; flex-direction: column; gap: 20px; }
        .project-media img, .project-media video { width: 100%; height: auto; border-radius: var(--btn-radius); box-shadow: var(--glass-shadow); display: block; }

        /* Custom Markdown Content Styles */
        .custom-content img, .custom-content video { width: 100%; height: auto; border-radius: var(--btn-radius); margin: 30px 0; box-shadow: var(--glass-shadow); display: block;}
        .custom-content h2, .custom-content h3 { font-family: 'Barlow Condensed', sans-serif; text-transform: uppercase; margin-top: 40px; color: var(--text-main); }
        .custom-content p { font-size: 16px; color: var(--text-muted); margin-bottom: 20px; line-height: 1.8; }
    </style>
</head>
<body>

    <nav>
        <a href="/" class="back-btn">← Back to Portfolio</a>
    </nav>

    <div class="container">
        <div class="glass-panel">
            <h1>{{ title }}</h1>
            
            <!-- MAGIC LAYOUT: This prints exactly what you build in the Full Page Design box. -->
            <div class="custom-content">
                {{ content }}
            </div>

            <!-- FALLBACK: If you leave the Full Page Design blank, it will safely load the basic homepage card data instead -->
            {% assign contentSize = content | strip | size %}
            {% if contentSize < 5 %}
                <div class="project-media">
                    {% if gallery %}
                        {% for item in gallery %}
                            {% if item contains '.mp4' or item contains '.webm' or item contains '.mov' %}
                                <video src="{{ item }}" autoplay loop muted playsinline controls></video>
                            {% else %}
                                <img src="{{ item }}" alt="{{ title }}">
                            {% endif %}
                        {% endfor %}
                    {% endif %}
                </div>
                <div class="subtitle-text">{{ subtitle }}</div>
            {% endif %}
            
        </div>
    </div>

</body>
</html>